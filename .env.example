# Copie para .env
PORT=3000
NODE_ENV=development
# Em produção, obrigatório. Gere um segredo longo e aleatório.
ADMIN_API_KEY=
# Origens autorizadas separadas por vírgula; não use *.
CORS_ORIGINS=http://localhost:3000
# Em produção, ambos os webhooks exigem HMAC-SHA256.
WEBHOOK_SECRET=
WEBHOOK_SECRET_WIMOVEIS=
WEBHOOK_SECRET_DFIMOVEIS=
WEBHOOK_SECRET_NETIMOVEIS=
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=corretor-bot
# Postgres (opcional — sem ele usa db.json local). Rode: psql $DATABASE_URL -f migrate.sql
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imoveis
# Monitor diário via cron (Linux): 0 8 * * * cd /caminho/sistema && node check-monitor.js
# NetImóveis WCF (leitura oficial) — src/integracoes/api/netimoveis-wcf.js
# Peça a apiKey à Rede NetImóveis (por agência/anunciante); sem ela a API retorna 401.
NETIMOVEIS_WCF_URL=https://wcfservices.netimoveis.com
NETIMOVEIS_API_KEY=
# Navent Open API — WImóveis/ImovelWeb (V4.3) — src/integracoes/api/navent-open.js
# Token via painel do anunciante (CLIENT_ID/CLIENT_SECRET -> POST /v1/application/login).
NAVENT_TOKEN=
NAVENT_ENV=sandbox
#NAVENT_BASE_URL=https://api-br.open.navent.com
#NAVENT_IMOBILIARIA=
